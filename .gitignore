# ==============================================================================
# 绝对防御：通用 .gitignore 模板
# 涵盖：全栈 Web (Next.js/Node) / AI 开发 (Python) / 跨平台操作系统 / 主流 IDE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 核心机密资产 (Secrets & Environment) - 【绝对防御区】
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example # 允许上传示例配置文件，供团队参考
!.env.template
*.pem
*.key
*.cert
secrets.json
credentials.json

# ------------------------------------------------------------------------------
# 2. 依赖黑洞 (Dependencies) - 【拒绝代码废料上云】
# ------------------------------------------------------------------------------
# Node.js生态
node_modules/
.pnp
.pnp.js
# Python生态 (AI 工具/算法脚本常用)
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
pip-log.txt

# ------------------------------------------------------------------------------
# 3. 框架编译与构建产物 (Builds & Frameworks)
# ------------------------------------------------------------------------------
# Next.js / React
.next/
out/
build/
# 常规前端产物
dist/
.parcel-cache/
# TypeScript
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 4. 运行日志与测试缓存 (Logs & Coverage)
# ------------------------------------------------------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
.eslintcache
.stylelintcache
coverage/
.nyc_output/

# ------------------------------------------------------------------------------
# 5. 编辑器与操作系统幽灵文件 (OS Ghosts & IDEs)
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
# IDEs (VS Code, Cursor, WebStorm)
.vscode/*
!.vscode/settings.json    # 保留团队统一设定的编辑器规则
!.vscode/extensions.json  # 保留推荐插件列表
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ------------------------------------------------------------------------------
# 6. 媒体与临时资源缓存 (Temp Media/Assets) - 【按需调整】
# ------------------------------------------------------------------------------
*.mp4
*.mkv
*.mov
# 如果你的项目涉及大量临时处理图片，可在此处拦截
# tmp/images/