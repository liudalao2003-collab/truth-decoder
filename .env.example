# 复制为 .env.local 后填写。切勿将真实密钥提交到 Git。
# 若 INGEST_TOKEN 曾出现在前端或公开仓库，请立即轮换并同步 Vercel / 爬虫环境。

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 必填：服务端写 public.profiles（Stripe Webhook、confirm-session）。缺失时 RLS 会阻止 upsert，表现为「付款成功但未变 Pro」。
SUPABASE_SERVICE_ROLE_KEY=

# 仅服务端：浏览器请求走 Cookie，爬虫/脚本可带 Bearer 调用 v1 接口
INGEST_TOKEN=

# 情报体征（入库 / 补算）必填；Vercel 须在 Project Settings 与本地一致注入，否则云端 metadata.intelProfile 为空或仅 intelProfileError
DEEPSEEK_API_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe（Pro 订阅）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=

# 管理后台邮箱比对（已有用法）
NEXT_PUBLIC_ADMIN_EMAIL=

# 可选：免费用户每月暗影卷宗成功落库次数上限（默认 3，UTC 自然月）
# DOSSIER_FREE_MONTHLY_LIMIT=3

# 可选
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CRON_SECRET=
